# Liferay DXP Docker Environment — base template
# Copia a .env y ajusta los valores para tu proyecto

# Liferay image
LIFERAY_IMAGE=liferay/dxp:2025.q1.0-lts

# JVM settings (ajustar según RAM disponible)
LIFERAY_JVM_OPTS="-Xms4g -Xmx6g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Djava.net.preferIPv4Stack=true"

# Elasticsearch
ES_JAVA_OPTS="-Xms2g -Xmx2g"
ES_HTTP_PORT=9200

# Liferay ports (host)
LIFERAY_HTTP_PORT=8080
LIFERAY_DEBUG_PORT=8000
GOGO_PORT=11311

# PostgreSQL
POSTGRES_DB=liferay
POSTGRES_USER=liferay
POSTGRES_PASSWORD=liferay
POSTGRES_PORT=5432

# Compose project name — mantener sin comentar (ver docker-compose.yml)
COMPOSE_PROJECT_NAME=liferay
VOLUME_PREFIX=liferay
DOCLIB_VOLUME_NAME=liferay-doclib

# Data root para bind mounts (bind mount local por defecto)
# En Linux con btrfs, configurar manualmente las vars de abajo si se quiere usar snapshots.
ENV_DATA_ROOT=./data/default

# Btrfs (opcional, solo Linux con btrfs montado).
# Descomentar y ajustar si se quiere usar snapshots para worktrees.
# El tooling NO escribe estas vars automáticamente.
#BTRFS_ROOT=/mnt/docker-btrfs
#BTRFS_BASE=/mnt/docker-btrfs/base
#BTRFS_ENVS=/mnt/docker-btrfs/envs
#USE_BTRFS_SNAPSHOTS=auto
#ENV_DATA_ROOT=/mnt/docker-btrfs/main

# IP de bind (127.0.0.1 para uso local)
BIND_IP=127.0.0.1

# URL base para liferay-cli
LIFERAY_CLI_URL=http://127.0.0.1:8080

# Liferay Cloud Platform (para db:sync y doclib:sync)
LCP_PROJECT=my-lcp-project
LCP_ENVIRONMENT=prd

# OAuth2 bootstrap (módulo liferay-cli-bootstrap)
# Configurar tras primer arranque con: task osgi:liferaycli-creds
LIFERAY_CLI_OAUTH2_COMPANY_WEB_ID=liferay.local
LIFERAY_CLI_OAUTH2_ADMIN_EMAIL=admin@liferay.local
